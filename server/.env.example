# Backend Port Configuration
PORT=5000

# Database URL
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/database_name

# JSON Web Token Secret (used for signing cookie sessions)
JWT_SECRET=your_jwt_signing_secret_here

# Firebase Admin Service Account Configuration
# Path to your Firebase service account JSON file (relative to server root)
FIREBASE_SERVICE_ACCOUNT=./firebaseServiceAccount.json

# OpenRouter LLM API Key (used for Llama AI interviews)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend Client URL (for CORS validation)
CLIENT_URL=http://localhost:5173
